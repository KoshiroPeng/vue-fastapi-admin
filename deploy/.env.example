# Application
APP_ENV=development
DEBUG=true
# Generate a unique production value with: openssl rand -hex 32
SECRET_KEY=change-me-before-production
CORS_ORIGINS=["http://localhost:3100"]
CORS_ALLOW_CREDENTIALS=true

# Docker Compose runs two backend containers on fixed host ports for native Nginx.
UVICORN_WORKERS=1
APP_BIND_IP=0.0.0.0
APP_PORT_1=19001
APP_PORT_2=19002
APP_DOCKER_SUBNET=10.78.0.0/24
APP_DOCKER_GATEWAY=10.78.0.1
APP_LOG_DIR=/srv/vue-fastapi-admin/logs/app

# WiFi gateway
NCE_MOCK_ENABLED=true
# Supported scenarios: healthy, auth_failure, business_failure, timeout, unavailable
NCE_MOCK_SCENARIO=healthy
# Shared Redis installed on the server or another managed host.
REDIS_URL=redis://:replace-with-redis-password@172.16.3.156:6379/0

# MySQL 8.0
MYSQL_HOST=172.16.3.156
MYSQL_PORT=3306
MYSQL_USER=vue_fastapi_admin
MYSQL_PASSWORD=
MYSQL_DATABASE=vue_fastapi_admin
MYSQL_POOL_MIN_SIZE=2
MYSQL_POOL_MAX_SIZE=10
MYSQL_CONNECT_TIMEOUT_SECONDS=10
# Dedicated HMAC secret for irreversible IP/MAC correlation hashes.
PII_HASH_SECRET=change-me-before-production
AUTH_TRANSACTION_TTL_SECONDS=300
NONCE_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_IP=30
RATE_LIMIT_PER_MAC=5
DASHBOARD_ONLINE_CACHE_TTL_SECONDS=5
DASHBOARD_RADIUS_CACHE_TTL_SECONDS=10
DASHBOARD_STATISTICS_CACHE_TTL_SECONDS=30
EXTERNAL_CALL_LOG_RETENTION_DAYS=30

# Real NCE values are intentionally blank while Mock mode is enabled.
NCE_BASE_URL=
NCE_PORTAL_AUTH_BASE_URL=
NCE_USERNAME=
NCE_PASSWORD=
NCE_TENANT_ID=
NCE_SITE_ID=
NCE_GUEST_USER_GROUP_ID=
NCE_TIMEOUT_MS=2500
# Keep disabled until the real NCE kick-session contract and permission boundary are approved.
NCE_KICK_ENABLED=false

# Third-party mini-program legacy NCE interfaces (SOAP guest creation + JSON portal authentication).
MINI_PROGRAM_GUEST_SERVICE_URL=https://wifi3.szairport.com:8443/secoWS/service/NewGuestManagerServices
MINI_PROGRAM_PORTAL_AUTH_URL=https://wifi5.szairport.com:8445/PortalServer/AppPortalAuth
MINI_PROGRAM_TIMEOUT_MS=5000
MINI_PROGRAM_TLS_VERIFY=true
MINI_PROGRAM_MAX_SOAP_BODY_BYTES=65536

# Authentication method switches
AUTH_SMS_ENABLED=true
AUTH_WECHAT_ENABLED=true
AUTH_BOARDING_PASS_ENABLED=true
AUTH_PASSPORT_ENABLED=true
AUTH_KIOSK_ENABLED=true
BOARDING_PASS_MOCK_ENABLED=true
OCR_MOCK_ENABLED=true
BOARDING_PASS_GUEST_VALID_MINUTES=480
PASSPORT_GUEST_VALID_MINUTES=480
PASSPORT_MAX_IMAGE_BYTES=4194304
WECHAT_CALLBACK_SECRET=change-me-before-production
WECHAT_CALLBACK_CLOCK_SKEW_SECONDS=300

# Kiosk integration; replace through a controlled secret store.
KIOSK_HMAC_SECRET=change-me-before-production
# Only these direct peers or CIDR ranges may supply X-Forwarded-For. Nginx must overwrite, not append, the header.
# Trust the fixed Docker bridge gateway for local Nginx and the Nginx host for remote app nodes.
TRUSTED_PROXY_IPS=["10.78.0.1","172.16.3.156"]
KIOSK_ALLOWED_IPS=["127.0.0.1","::1"]
KIOSK_CLOCK_SKEW_SECONDS=300
KIOSK_GUEST_VALID_MINUTES=1440
KIOSK_MAX_BODY_BYTES=8192
WIFI_SSID=Airport-Free-WiFi
